# Public HTTPS address configured in DNS and the host Nginx virtual host.
APP_URL=https://pts.moa.gov.et

# The containers bind only to loopback; host Nginx publishes HTTPS.
APP_HTTP_PORT=8081

POSTGRES_DB=moa_procurement
POSTGRES_USER=moa_procurement_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD

# Generate with: openssl rand -hex 48
JWT_SECRET=REPLACE_WITH_A_96_CHARACTER_RANDOM_HEX_VALUE

MAIL_FROM=MoA Procurement Tracking System <no-reply@moa.gov.et>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
