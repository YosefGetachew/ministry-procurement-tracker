# Copy this file to .env and fill in your PostgreSQL credentials

# Option A: full connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/moa_procurement

# Option B (used only if DATABASE_URL is not set): individual fields
PGHOST=127.0.0.1
PGPORT=5434
PGDATABASE=moa_procurement
PGUSER=postgres
PGPASSWORD=postgres

PORT=4000

# Origin the frontend is served from (must match exactly, no trailing slash)
FRONTEND_ORIGIN=http://localhost:5173

# Secret used to sign login session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
APP_LOGIN_URL=http://localhost:5173
MAIL_FROM=MoA Procurement Tracking System <no-reply@moa.gov.et>
# Configure these values to send committee invitations through your mail server.
# Without them, development invitations are written to backend/outbox as .eml files.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
